# Copy to .env and fill in. .env is git-ignored.

# Q-SYS Core (QRC on port 1710)
qUsername=
qPassword=
qCoreIp=
# Text Controller used as the runtime test bed
qComponent=

# Optional: the plugin tools Docker image the build uses, e.g. a Docker Hub image published with
# `npm run image:publish`. When empty, the build makes its own image from docker/.
QSYS_TOOLS_IMAGE=

# Only for `npm run build -- --native` (Windows): folder holding the QSC plugin tool repos
# basicpluginframework (PLUGCC compiler), PluginEncryptionTool and Plugin-Evaluation-Script.
PLUGIN_TOOLS_DIR=C:\Bitbucket\Qsys Plugin Development

# Optional: Designer's Plugins folder for `npm run build -- --install`. Defaults to
# Documents\QSC\Q-Sys Designer\Plugins on Windows; required on macOS/Linux (e.g. a VM shared folder).
QSYS_PLUGIN_DIR=
